# .env.example — Copy this to .env and fill in values
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/sentinelstream
SECRET_KEY=change-this-to-64-random-characters-in-production-never-commit
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
DEBUG=True
ML_MODEL_PATH=ml/fraud_model.joblib
ML_RISK_THRESHOLD=0.7
RATE_LIMIT_PER_MINUTE=1000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
